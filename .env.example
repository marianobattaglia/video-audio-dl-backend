# Open access by default; access control is available when you enable it.
AUTH_REQUIRED=false
# Required only with AUTH_REQUIRED=true: random, >=24 chars, no whitespace.
# Never put a credential in the frontend repository or a Vercel variable.
ACCESS_CREDENTIAL=
YOUTUBE_COOKIES_FILE=
# Optional runtime Secret File in Render: /etc/secrets/youtube-cookies.txt
# When configured, AUTH_REQUIRED=true and a valid ACCESS_CREDENTIAL are mandatory.
# Keep the source outside both repos and temp trees. Compose needs an explicit
# external read-only mount; this example does not mount any real session.
FRONTEND_ORIGINS=http://localhost:5173
# Native Node reads process environment; .env is loaded by Docker Compose only.
